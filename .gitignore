# Raw/processed data — large parquet files, never commit these
data/raw/
data/processed/
*.parquet

# ...except the dashboard's gold-table snapshot, which ships with the
# deployed app instead of being generated at runtime (metadata.json isn't
# caught by *.parquet above, but is listed here for clarity)
!dashboard/snapshot/*.parquet
!dashboard/snapshot/metadata.json

# Databricks CLI config (contains OAuth token references)
.databrickscfg

# Python
__pycache__/
*.pyc
.venv/
venv/

# Notebook checkpoints
.ipynb_checkpoints/

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
*.code-workspace
